[Unit]
Description=RSI2 Option Selling Bot (Delta Exchange India)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hemang
WorkingDirectory=/home/hemang/rsi-option
ExecStart=/home/hemang/rsi-option/venv/bin/python main.py
Restart=always
RestartSec=15
StandardOutput=append:/home/hemang/rsi-option/bot.log
StandardError=append:/home/hemang/rsi-option/bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
